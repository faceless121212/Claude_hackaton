FAL_KEY=your-fal-key-here
# FAL_KEY also powers the tutor voices and the microphone transcription.
# With only ANTHROPIC_API_KEY set, voice falls back to the browser's built-in speech.
# Optional: use Claude directly instead of through fal
# ANTHROPIC_API_KEY=
# The tutor runs on Claude Fable 5.2. For a cheaper, lighter model, uncomment the line that matches your key:
# MODEL=anthropic/claude-sonnet-5.5
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Voice mode uses a faster model for spoken turns. Set these to change it.
# VOICE_MODEL=anthropic/claude-haiku-5.5
# ANTHROPIC_VOICE_MODEL=claude-haiku-5-5
# PORT=3000
